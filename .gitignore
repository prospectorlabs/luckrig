.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*~

# Logs
*.log
logs/

# Env / secrets
.env
.env.*
!.env.example

# Cryptographic keys (keygen writes {prefix}-private.pem / -public.pem into the
# working tree; node private key = prompt-decryption key, must never be committed)
*.pem
*.key

# luckrig local/runtime data (must never be committed)
.luckrig/
**/history/*.json
data/*.jsonl
data/*.sqlite
data/*.sqlite-*

# Build outputs (placeholders for future stacks)
dist/
build/
out/
target/
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# personal sync helper (not part of repo)
sync.sh
